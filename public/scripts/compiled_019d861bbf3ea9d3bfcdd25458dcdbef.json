          "actionId": "talk_angry",
          "expressionId": "angry",
          "expressionTag": "angry",
          "facing": "left",
          "position": "mid_center",
          "dialogue": "Học hành gì? Mày trượt rồi! Đừng có nằm mơ nữa!",
