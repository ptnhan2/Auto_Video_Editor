          "expressionId": "sad",
          "expressionTag": "sad",
          "facing": "left",
          "position": "mid_center",
          "dialogue": "Bà nội, cháu muốn đi học tiếp, cháu muốn thi đại học...",
          "isSpeaking": true,
          "audioId": "aud_sb019d8780ef51949f395e980f65565a49"
        },
